# Rust
/target/
**/*.rs.bk

# Scan output / renders
/scans/
/frames/
# Rendered output from a comparison or one-off run, e.g. frames-match,
# frames-one. Globbed rather than listed so a new one does not have to be
# added here before it stops cluttering `git status`.
/frames-*/
*.mp4
*.webm
*.gif
scan_*.json

# Exported image sequences and video. The output folder is whatever gets
# passed to --export, so this only covers the names the README suggests;
# anything else is on you to keep out of a commit.
/out/
/out-*/
/timelapses/
*.avi

# ...except intentional, committed demo media.
!assets/*.mp4
!assets/*.webm
!assets/*.gif
!assets/*.avi

# Packaged mod
/dist/
*.zip

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
